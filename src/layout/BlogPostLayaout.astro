---
import Layout from './Layout.astro';

interface Props {
    title: string;
    description: string;
    date: Date;
    difficulty: string;
    platform: string;
    os: string;
    tags: string[];
}

const {
    title,
    description,
    date,
    difficulty,
    platform,
    os,
    tags
} = Astro.props;

const formattedDate = date.toLocaleDateString('es-MX', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
});
---

<Layout
    title={`${title} | Cybersecurity Blog`}
    description={description}
>

    <main class="post">

        <a class="back" href="/blog">
            ← Volver al Blog
        </a>

        <header class="postHeader">

            <span class="category">
                {platform}
            </span>

            <h1>{title}</h1>

            <p class="description">
                {description}
            </p>

            <div class="metadata">

                <span>
                    🎯 {difficulty}
                </span>

                <span>
                    🐧 {os}
                </span>

                <time datetime={date.toISOString()}>
                    📅 {formattedDate}
                </time>

            </div>

            <div class="tags">
                {tags.map((tag) => (
                    <span>#{tag}</span>
                ))}
            </div>

        </header>

        <article class="content">
            <slot />
        </article>

        <footer class="postFooter">

            <a href="/blog">
                ← Ver más writeups
            </a>

        </footer>

    </main>

</Layout>

<style>
    .post {
        width: min(900px, 90%);
        margin: 0 auto;
        padding: 8rem 0 5rem;
        color: var(--neutral-light);
    }

    .back {
        color: var(--primary-accent);
        text-decoration: none;
        font-weight: 600;
    }

    .postHeader {
        padding: 3rem 0;

        border-bottom: 1px solid
            rgba(255, 255, 255, 0.1);
    }

    .category {
        color: var(--primary-accent);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .postHeader h1 {
        margin: 0.7rem 0;
        font-size: clamp(2.5rem, 7vw, 4.5rem);
    }

    .description {
        max-width: 700px;

        font-size: 1.1rem;
        line-height: 1.7;

        color: var(--color-text);
    }

    .metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;

        margin: 1.5rem 0;
    }

    .metadata span,
    .metadata time {
        font-size: 0.85rem;
        color: var(--color-text);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tags span {
        padding: 0.35rem 0.6rem;

        border-radius: 6px;

        background: rgba(255, 255, 255, 0.06);

        font-size: 0.75rem;
        color: var(--text-white-light);
    }

    .content {
        padding-top: 3rem;

        line-height: 1.8;
        color: var(--color-text);
    }

    .content :global(h2),
    .content :global(h3),
    .content :global(h4) {
        color: var(--neutral-light);
    }

    .content :global(h2) {
        margin-top: 3rem;
        margin-bottom: 1rem;
    }

    .content :global(h3) {
        margin-top: 2rem;
    }

    .content :global(p) {
        margin: 1rem 0;
    }

    .content :global(a) {
        color: var(--primary-accent);
    }

    .content :global(li) {
        color: var(--color-text);
    }

    .content :global(strong) {
        color: var(--neutral-light);
    }

    .content :global(pre) {
        overflow-x: auto;

        padding: 1.25rem;

        border-radius: 10px;

        background: #111;

        border: 1px solid
            rgba(255, 255, 255, 0.08);
    }

    .content :global(code) {
        font-family: monospace;
        color: var(--strongColor);
    }

    .content :global(pre code) {
        color: var(--neutral-light);
    }

    .content :global(img) {
        display: block;

        max-width: 100%;
        height: auto;

        margin: 2rem auto;

        border-radius: 10px;
    }

    .content :global(blockquote) {
        margin: 2rem 0;
        padding: 1rem 1.5rem;

        border-left: 3px solid
            var(--primary-accent);

        background: rgba(255, 255, 255, 0.03);
    }

    .postFooter {
        margin-top: 4rem;
        padding-top: 2rem;

        border-top: 1px solid
            rgba(255, 255, 255, 0.1);
    }

    .postFooter a {
        color: var(--primary-accent);
        text-decoration: none;
        font-weight: 600;
    }
</style>